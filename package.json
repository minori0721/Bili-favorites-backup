{
  "name": "bili-favorites-backup",
  "version": "2.7.3-dev",
  "private": true,
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/minori0721/Bili-favorites-backup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minori0721/Bili-favorites-backup.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "pretest": "npm run build:web",
    "pretest:core": "npm run build:web",
    "pretest:ui": "npm run build:web",
    "state:export-json": "tsx src/scripts/sqlite-to-json.ts",
    "benchmark:state": "tsx src/scripts/benchmark-state.ts",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --scope quick",
    "test:core": "node scripts/test.mjs --scope core",
    "test:slow": "node scripts/test.mjs --scope slow",
    "test:release": "node scripts/test.mjs --scope release",
    "test:decoder": "node scripts/test.mjs --scope decoder",
    "test:upload": "node scripts/test.mjs --scope upload",
    "test:scheduler": "node scripts/test.mjs --scope scheduler",
    "test:files": "node scripts/test.mjs --files",
    "test:ui": "playwright test",
    "start": "node dist/index.js",
    "login": "tsx src/scripts/login.ts"
  },
  "dependencies": {
    "@renmu/bili-api": "^2.14.0",
    "archiver": "^8.0.0",
    "artplayer": "5.4.0",
    "better-sqlite3": "12.11.1",
    "driver.js": "1.10.2",
    "express": "^4.22.2",
    "express-rate-limit": "8.5.2",
    "express-session": "^1.18.0",
    "markdown-it": "15.0.3",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "webdav": "^5.10.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "@renmu/bili-api": {
      "axios": "1.20.0",
      "fast-xml-parser": "5.7.3"
    },
    "body-parser": "1.20.9",
    "follow-redirects": "1.16.1",
    "qs": "6.16.1",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3"
  }
}
