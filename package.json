{
  "name": "bili-favorites-backup",
  "version": "2.6.2",
  "private": true,
  "homepage": "https://github.com/minori0721/Bili-favorites-backup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minori0721/Bili-favorites-backup.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "pretest": "npm run build:web",
    "pretest:ui": "npm run build:web",
    "state:export-json": "tsx src/scripts/sqlite-to-json.ts",
    "benchmark:state": "tsx src/scripts/benchmark-state.ts",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --scope quick",
    "test:decoder": "node scripts/test.mjs --scope decoder",
    "test:upload": "node scripts/test.mjs --scope upload",
    "test:scheduler": "node scripts/test.mjs --scope scheduler",
    "test:files": "node scripts/test.mjs --files",
    "test:ui": "playwright test",
    "start": "node dist/index.js",
    "login": "tsx src/scripts/login.ts"
  },
  "dependencies": {
    "@renmu/bili-api": "^2.14.0",
    "archiver": "^8.0.0",
    "artplayer": "5.4.0",
    "better-sqlite3": "12.11.1",
    "express": "^4.22.2",
    "express-rate-limit": "8.5.2",
    "express-session": "^1.18.0",
    "markdown-it": "15.0.1",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "webdav": "^5.10.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "@renmu/bili-api": {
      "axios": "1.18.0",
      "fast-xml-parser": "5.7.3"
    },
    "body-parser": "1.20.6",
    "qs": "6.16.0",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "ip-address": "10.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3"
  }
}
